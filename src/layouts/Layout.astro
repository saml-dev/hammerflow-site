---
import '../styles/global.css';
import github from '../assets/github.svg';
import metaImage from '../assets/meta.png';
import ThemePicker from '../components/ThemePicker.svelte';
let aSite = Astro.site!;
aSite.pathname = metaImage.src;
let metaImageUrl = import.meta.env.PROD ? aSite.toString() : metaImage.src;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width'
    />
    <link
      rel='icon'
      href='https://fav.farm/⚒️'
    />
    <meta
      name='generator'
      content={Astro.generator}
    />

    <!-- Open Graph tags -->
    <meta
      property='og:title'
      content='The most productive way to control your Mac'
    />
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:url'
      content='https://hammerflow.dev/'
    />
    <meta
      property='og:description'
      content='The most productive way to control your Mac'
    />
    <meta
      property='og:image'
      content={metaImageUrl}
    />
    <meta
      property='og:image:alt'
      content='Hammerflow'
    />

    <!-- Twitter -->
    <meta
      name='twitter:card'
      content='summary_large_image'
    />
    <meta
      name='twitter:title'
      content='Hammerflow'
    />
    <meta
      name='twitter:description'
      content='The most productive way to control your Mac'
    />
    <meta
      name='twitter:image'
      content={metaImageUrl}
    />

    <title>{import.meta.env.PROD ? 'Hammerflow' : 'Local Hammerflow'}</title>
    <script is:inline>
      try {
        var p = new URLSearchParams(window.location.search).get('theme');
        var s = localStorage.getItem('hf-theme');
        var v = ['aurora', 'keycaps', 'patchbay', 'warp'];
        var t = (p && v.indexOf(p) !== -1) ? p : (s && v.indexOf(s) !== -1) ? s : 'aurora';
        document.documentElement.dataset.hfTheme = t;
      } catch (e) {}
    </script>
  </head>
  <body class='text-gray-900'>
    <nav class='pt-4'>
      <div
        class='text-lg md:text-xl font-medium max-w-5xl px-4 md:px-8 mx-auto flex items-baseline justify-between'
      >
        <a href='/'>Hammerflow</a>
        <a
          target='_blank'
          href='https://github.com/saml-dev/Hammerflow.spoon.git'
          ><img
            class='size-6'
            src={github.src}
            alt='github logo'
          />
        </a>
      </div>
    </nav>
    <div class='max-w-5xl pb-40 px-4 md:px-8 mx-auto'>
      <slot />
    </div>
    <div
      id='background'
      aria-hidden='true'
    >
      <div class='hf-orb hf-orb-1'></div>
      <div class='hf-orb hf-orb-2'></div>
      <div class='hf-orb hf-orb-3'></div>
      <div class='hf-orb hf-orb-4'></div>
      <div class='hf-veil'></div>
      <div class='hf-grid'></div>
      <div class='hf-grain'></div>
      <div class='hf-grain-fine'></div>
    </div>
    <ThemePicker client:load />
  </body>
</html>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    position: relative;
    transition: color 0.25s ease;
  }

  #background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #fcfbf8;
    isolation: isolate;
  }

  :global(html[data-hf-theme='keycaps']) #background,
  :global(html[data-hf-theme='patchbay']) #background,
  :global(html[data-hf-theme='warp']) #background {
    display: none;
  }

  .hf-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    mix-blend-mode: multiply;
    opacity: 0.88;
    will-change: transform;
  }

  .hf-orb-1 {
    width: max(60vw, 480px);
    height: max(74vh, 480px);
    top: -22%;
    left: -12%;
    background: radial-gradient(circle at 45% 45%, #c4b5fd 0%, #e9d5ff 48%, transparent 72%);
    animation: hf-drift-1 18s ease-in-out infinite alternate;
  }

  .hf-orb-2 {
    width: max(62vw, 500px);
    height: max(74vh, 500px);
    top: -22%;
    right: -12%;
    background: radial-gradient(circle at 50% 45%, #fcd34d 0%, #fed7aa 48%, transparent 72%);
    animation: hf-drift-2 21s ease-in-out infinite alternate;
  }

  .hf-orb-3 {
    width: max(60vw, 480px);
    height: max(74vh, 480px);
    bottom: -16%;
    left: -4%;
    background: radial-gradient(circle at 50% 50%, #5eead4 0%, #bbf7d0 48%, transparent 72%);
    animation: hf-drift-3 24s ease-in-out infinite alternate;
  }

  .hf-orb-4 {
    width: max(58vw, 460px);
    height: max(72vh, 460px);
    bottom: -14%;
    right: -4%;
    background: radial-gradient(circle at 50% 50%, #7dd3fc 0%, #f9a8d4 52%, transparent 74%);
    animation: hf-drift-4 19s ease-in-out infinite alternate;
  }

  .hf-veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 68% 58% at 50% 46%,
      rgba(255, 254, 250, 0.3) 0%,
      rgba(255, 254, 250, 0.04) 100%
    );
  }

  .hf-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(17, 24, 39, 0.14) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.42;
    -webkit-mask-image: radial-gradient(ellipse 82% 78% at 50% 44%, #000 20%, transparent 100%);
    mask-image: radial-gradient(ellipse 82% 78% at 50% 44%, #000 20%, transparent 100%);
  }

  /* Tactile monochrome film grain — dual-pass for crisp texture on both pastels and near-white */
  .hf-grain {
    position: absolute;
    inset: 0;
    opacity: 0.38;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3CfeComponentTransfer%3E%3CfeFuncR type='linear' slope='2.2' intercept='-0.6'/%3E%3CfeFuncG type='linear' slope='2.2' intercept='-0.6'/%3E%3CfeFuncB type='linear' slope='2.2' intercept='-0.6'/%3E%3C/feComponentTransfer%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 160px 160px;
  }

  .hf-grain-fine {
    position: absolute;
    inset: 0;
    opacity: 0.11;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3CfeComponentTransfer%3E%3CfeFuncR type='linear' slope='2.4' intercept='-0.55'/%3E%3CfeFuncG type='linear' slope='2.4' intercept='-0.55'/%3E%3CfeFuncB type='linear' slope='2.4' intercept='-0.55'/%3E%3C/feComponentTransfer%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 140px 140px;
  }

  @keyframes hf-drift-1 {
    0% { transform: translate3d(0%, 0%, 0) scale(1); }
    50% { transform: translate3d(12%, 10%, 0) scale(1.08); }
    100% { transform: translate3d(4%, 18%, 0) scale(0.96); }
  }

  @keyframes hf-drift-2 {
    0% { transform: translate3d(0%, 0%, 0) scale(1.04); }
    50% { transform: translate3d(-14%, 8%, 0) scale(0.95); }
    100% { transform: translate3d(-6%, 16%, 0) scale(1.09); }
  }

  @keyframes hf-drift-3 {
    0% { transform: translate3d(0%, 0%, 0) scale(1); }
    50% { transform: translate3d(14%, -12%, 0) scale(1.1); }
    100% { transform: translate3d(22%, -4%, 0) scale(0.98); }
  }

  @keyframes hf-drift-4 {
    0% { transform: translate3d(0%, 0%, 0) scale(1.02); }
    50% { transform: translate3d(-12%, -10%, 0) scale(1.1); }
    100% { transform: translate3d(-18%, 4%, 0) scale(0.95); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-orb {
      animation: none;
    }
  }

  /* =========================================================================
     THEME 1: KEYCAP MATRIX — subtle frosted readability lift
     ========================================================================= */
  :global(html[data-hf-theme='keycaps'] .bg-soft-yellow) {
    background-color: rgba(255, 255, 245, 0.9);
    backdrop-filter: blur(10px);
  }

  /* =========================================================================
     THEME 2: PATCHBAY LAB — Teenage Engineering / Braun Industrial Styling
     ========================================================================= */
  :global(html[data-hf-theme='patchbay'] body) {
    color: #18181b;
  }

  :global(html[data-hf-theme='patchbay'] h1) {
    letter-spacing: -0.035em;
  }

  :global(html[data-hf-theme='patchbay'] nav a:first-child) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-decoration: none;
  }

  :global(html[data-hf-theme='patchbay'] a) {
    text-decoration-color: #ff4d00;
  }

  :global(html[data-hf-theme='patchbay'] kbd) {
    background: #faf9f5 !important;
    border: 1.5px solid #18181b !important;
    border-radius: 5px !important;
    box-shadow: 0 3px 0 0 #18181b !important;
  }

  :global(html[data-hf-theme='patchbay'] kbd:hover) {
    border-color: #ff4d00 !important;
    box-shadow: 0 5px 0 0 #ff4d00 !important;
  }

  :global(html[data-hf-theme='patchbay'] .bg-soft-yellow) {
    background-color: rgba(248, 247, 243, 0.92);
    backdrop-filter: blur(8px);
    border-color: rgba(24, 24, 27, 0.25);
  }

  :global(html[data-hf-theme='patchbay'] .shadow),
  :global(html[data-hf-theme='patchbay'] .shadow-sm) {
    border: 1.5px solid rgba(24, 24, 27, 0.2);
    box-shadow: 3px 3px 0 rgba(24, 24, 27, 0.1);
  }

  /* =========================================================================
     THEME 3: WARP DRIVE — Full Dark-Mode Neon Hyperdrive Transformation
     ========================================================================= */
  :global(html[data-hf-theme='warp'] body) {
    color: #f1f5f9;
  }

  :global(html[data-hf-theme='warp'] h1) {
    color: #ffffff;
    text-shadow: 0 0 32px rgba(56, 189, 248, 0.3);
  }

  :global(html[data-hf-theme='warp'] a) {
    color: #7dd3fc;
  }

  :global(html[data-hf-theme='warp'] nav a) {
    color: #f8fafc;
  }

  :global(html[data-hf-theme='warp'] nav img) {
    filter: invert(1);
  }

  :global(html[data-hf-theme='warp'] .text-gray-700),
  :global(html[data-hf-theme='warp'] .text-gray-600) {
    color: #94a3b8;
  }

  :global(html[data-hf-theme='warp'] img.bg-white\/50) {
    background-color: rgba(224, 242, 254, 0.92);
    box-shadow: 0 0 18px rgba(56, 189, 248, 0.35);
  }

  :global(html[data-hf-theme='warp'] kbd) {
    background: #12152a !important;
    color: #f8fafc !important;
    border-color: rgba(56, 189, 248, 0.5) !important;
    box-shadow:
      0 3px 0 0 rgba(56, 189, 248, 0.4),
      0 0 18px rgba(56, 189, 248, 0.18) !important;
  }

  :global(html[data-hf-theme='warp'] kbd:hover) {
    border-color: rgba(168, 85, 247, 0.75) !important;
    box-shadow:
      0 5px 0 0 rgba(168, 85, 247, 0.5),
      0 0 24px rgba(168, 85, 247, 0.3) !important;
  }

  :global(html[data-hf-theme='warp'] .bg-white) {
    background-color: rgba(15, 20, 40, 0.8);
    border: 1px solid rgba(168, 85, 247, 0.32);
    color: #f8fafc;
    backdrop-filter: blur(14px);
    box-shadow: 0 0 28px rgba(139, 92, 246, 0.18);
  }

  :global(html[data-hf-theme='warp'] .animated-action img) {
    background: rgba(248, 250, 252, 0.92);
    padding: 4px;
    border-radius: 8px;
  }

  :global(html[data-hf-theme='warp'] .bg-white\/20) {
    background-color: rgba(15, 20, 40, 0.5);
    border-color: rgba(56, 189, 248, 0.28);
  }

  :global(html[data-hf-theme='warp'] .bg-soft-yellow) {
    background-color: rgba(15, 20, 40, 0.84);
    color: #e2e8f0;
    border-color: rgba(56, 189, 248, 0.25);
    backdrop-filter: blur(14px);
  }

  :global(html[data-hf-theme='warp'] .border-b-gray-200) {
    border-bottom-color: rgba(148, 163, 184, 0.2);
  }

  :global(html[data-hf-theme='warp'] pre.astro-code) {
    border: 1px solid rgba(56, 189, 248, 0.22);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
</style>
